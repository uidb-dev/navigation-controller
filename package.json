{
  "name": "navigation-controller",
  "version": "5.0.0-beta.1",
  "description": "Level-based back navigation for React. Bring your own router and your own animations.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./transitions": {
      "import": {
        "types": "./dist/transitions.d.mts",
        "default": "./dist/transitions.mjs"
      },
      "require": {
        "types": "./dist/transitions.d.ts",
        "default": "./dist/transitions.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "pretest:react18": "npm --prefix test-react18 install --no-audit --no-fund",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:docs": "tsc -p tsconfig.docs.json",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uidb-dev/navigation-controller.git"
  },
  "keywords": [
    "back-navigation",
    "navigation-stack",
    "hierarchical-navigation",
    "level-stack",
    "hardware-back-button",
    "android-back-button",
    "view-transitions",
    "headless",
    "react-router",
    "nextjs",
    "webview",
    "capacitor",
    "cordova",
    "ionic",
    "react",
    "mobile"
  ],
  "author": {
    "name": "ui-db.com",
    "email": "hello@ui-db.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/uidb-dev/navigation-controller/issues"
  },
  "homepage": "https://github.com/uidb-dev/navigation-controller#readme",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
